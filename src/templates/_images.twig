{% import '_includes/forms' as forms %}
{# Utilities → Supertext images (utilities/ImagesUtility). #}
<p>{{ 'Every image in the CKEditor texts Supertext translated, the source’s image beside the site’s. When a translation is overwritten, an image the site has of its own (a localized screenshot, for example) is kept as long as the source’s image in that place doesn’t change; when it changes, the site gets the new image and it is listed here as to check.'|t('supertext-translation') }}</p>
{% if checked %}<p class="success">{{ 'Marked as checked.'|t('supertext-translation') }}</p>{% endif %}

<nav class="btngroup" aria-label="{{ 'Show'|t('supertext-translation') }}" style="margin: 1em 0">
    {% for value, label in { all: 'All'|t('supertext-translation'), check: 'To check'|t('supertext-translation'), own: 'Own image'|t('supertext-translation'), same: 'Same as the source'|t('supertext-translation') } %}
        <a class="btn{{ status == value ? ' active' : '' }}" href="{{ cpUrl('utilities/supertext-images', value == 'all' ? {} : { status: value }) }}">{{ label }} ({{ counts[value] ?? 0 }})</a>
    {% endfor %}
</nav>

{% if rows is empty %}
    {% if counts.all == 0 %}
        <p class="light">{{ 'No images recorded yet. Supertext records them whenever it writes a translation.'|t('supertext-translation') }}</p>
    {% else %}
        <p class="light">{{ 'No images with this status.'|t('supertext-translation') }}</p>
    {% endif %}
{% else %}
    <table class="data fullwidth">
        <thead>
            <tr>
                <th>{{ 'Site'|t('supertext-translation') }}</th>
                <th>{{ 'Content'|t('supertext-translation') }}</th>
                <th>{{ 'Source image'|t('supertext-translation') }}</th>
                <th>{{ 'Site’s image'|t('supertext-translation') }}</th>
                <th>{{ 'Status'|t('supertext-translation') }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr>
                    <td>{{ row.site }}</td>
                    <td>
                        {% if row.editUrl %}<a href="{{ row.editUrl }}">{{ row.title }}</a>{% else %}<span class="light">{{ row.elementId }}</span>{% endif %}
                        <div class="light smalltext">{{ row.fieldName|t('site') }}</div>
                    </td>
                    {% for url in [row.originalUrl, row.url] %}
                        <td>{% if url %}<a href="{{ url }}" target="_blank" rel="noopener"><img src="{{ url }}" alt="" width="96" height="64" style="object-fit: cover; border-radius: 4px; border: 1px solid #e3e5e8"></a>{% else %}<code class="smalltext">{{ loop.index == 1 ? row.original : row.src }}</code>{% endif %}</td>
                    {% endfor %}
                    <td>
                        <span class="status-label {{ row.status == 'check' ? 'orange' : (row.status == 'own' ? 'green' : 'gray') }}"><span class="status {{ row.status == 'check' ? 'orange' : (row.status == 'own' ? 'green' : '') }}"></span><span class="status-label-text">{{ { check: 'To check'|t('supertext-translation'), own: 'Own image'|t('supertext-translation'), same: 'Same as the source'|t('supertext-translation') }[row.status] ?? row.status }}</span></span>
                        {% if row.reason %}
                            <div class="light smalltext">{{ {
                                originalChanged: 'The source’s image was replaced, so the site got the new one instead of its own.'|t('supertext-translation'),
                                noRecord: 'The site’s own image was kept (translated before Supertext recorded images). Check it still fits.'|t('supertext-translation'),
                                layoutChanged: 'The site’s images no longer matched the source’s, so it got the source’s.'|t('supertext-translation'),
                            }[row.reason] ?? '' }}</div>
                        {% endif %}
                    </td>
                    <td>
                        {% if row.status == 'check' %}
                            <form method="post" accept-charset="UTF-8">
                                {{ actionInput('supertext-translation/images/checked') }}
                                {{ csrfInput() }}
                                {{ hiddenInput('elementId', row.elementId) }}
                                {{ hiddenInput('siteId', row.siteId) }}
                                {{ hiddenInput('field', row.field) }}
                                {{ hiddenInput('slot', row.slot) }}
                                {{ hiddenInput('status', status) }}
                                <button type="submit" class="btn small" title="{{ 'After you checked the image (and replaced it with a localized one, if needed). Supertext then keeps whatever image the site has.'|t('supertext-translation') }}">{{ 'Mark as checked'|t('supertext-translation') }}</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    {% if pages > 1 %}
        <p>
            {{ 'Page {page} of {pages}'|t('supertext-translation', { page: page, pages: pages }) }}
            {% if page > 1 %}· <a href="{{ cpUrl('utilities/supertext-images', { status: status, page: page - 1 }) }}">{{ 'Previous page'|t('supertext-translation') }}</a>{% endif %}
            {% if page < pages %}· <a href="{{ cpUrl('utilities/supertext-images', { status: status, page: page + 1 }) }}">{{ 'Next page'|t('supertext-translation') }}</a>{% endif %}
        </p>
    {% endif %}
{% endif %}
